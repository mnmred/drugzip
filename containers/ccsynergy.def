Bootstrap: docker
From: condaforge/miniforge3:latest

# DrugZip / CCSynergy stack (README pins + tensorflow[and-cuda] + wandb).
# Project code is NOT baked in — bind-mount the repo at runtime.
# Build from the repo root so environment.yml is on the %files path:
#   apptainer build containers/ccsynergy.sif containers/ccsynergy.def
# Then copy/overwrite $PROJECTDIR/containers/ccsynergy.sif on the cluster.

%files
    environment.yml /opt/environment.yml

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        git git-lfs build-essential \
        ca-certificates curl wget \
        fontconfig fonts-dejavu-core \
        libglib2.0-0 libsm6 libxrender1 libxext6 libgl1 \
        tree time vim ncdu tmux rsync
    git lfs install
    fc-cache -fv
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    mkdir -p \
        /opt/.cache/matplotlib \
        /opt/.cache/fontconfig \
        /opt/.cache/wandb
    chmod -R 777 /opt/.cache

    # Drop keys that are conda config, not env-file fields
    grep -vE '^(channel_priority:)' /opt/environment.yml > /tmp/environment.yml

    . "/opt/conda/etc/profile.d/conda.sh"
    mamba env create -y -f /tmp/environment.yml
    conda activate ccsynergy

    mkdir -p /opt/conda/envs/ccsynergy/etc/conda/activate.d
    # IMPORTANT: append conda libs — never prepend over Apptainer --nv
    # (/.singularity.d/libs must stay first so libcuda.so resolves).
    cat > /opt/conda/envs/ccsynergy/etc/conda/activate.d/env_vars.sh <<'EOF'
_CCSY_LIB=/opt/conda/envs/ccsynergy/lib
_CCSY_SITE="${_CCSY_LIB}/python3.10/site-packages"
# Keep existing LD_LIBRARY_PATH (incl. /.singularity.d/libs from --nv) ahead of conda
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}${_CCSY_LIB}"
# tensorflow[and-cuda] ships nvidia-*/lib wheels that TF dlopens at runtime
if [ -d "${_CCSY_SITE}/nvidia" ]; then
  for _nvlib in "${_CCSY_SITE}"/nvidia/*/lib "${_CCSY_SITE}"/nvidia/*/lib64; do
    [ -d "${_nvlib}" ] && LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${_nvlib}"
  done
  export LD_LIBRARY_PATH
fi
unset _CCSY_LIB _CCSY_SITE _nvlib
EOF

    conda clean -afy || true
    mamba clean --all -y || true

    echo '. "/opt/conda/etc/profile.d/conda.sh"' >> "${APPTAINER_ENVIRONMENT}"
    echo 'conda activate ccsynergy' >> "${APPTAINER_ENVIRONMENT}"

%environment
    export PATH="/opt/conda/bin:${PATH}"
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
    export XDG_CACHE_HOME=/opt/.cache
    export MPLCONFIGDIR=/opt/.cache/matplotlib
    export MPLBACKEND=Agg
    export FONTCONFIG_PATH=/etc/fonts
    # Prefer host driver libs injected by apptainer --nv
    export NVIDIA_VISIBLE_DEVICES="${NVIDIA_VISIBLE_DEVICES:-all}"
    export NVIDIA_DRIVER_CAPABILITIES="${NVIDIA_DRIVER_CAPABILITIES:-compute,utility}"

%runscript
    if [ $# -gt 0 ]; then
        exec "$@"
    else
        cat <<'EOF'
ccsynergy / DrugZip (Python 3.10; tensorflow[and-cuda]).
Use --nv on GPU nodes. Rebuild after environment.yml changes:

  apptainer build containers/ccsynergy.sif containers/ccsynergy.def
EOF
    fi

%test
    export XDG_CACHE_HOME=/opt/.cache
    export MPLCONFIGDIR=/opt/.cache/matplotlib
    export MPLBACKEND=Agg
    . "/opt/conda/etc/profile.d/conda.sh"
    conda activate ccsynergy
    python - <<'PY'
import sys
import numpy
import scipy
import pandas
import sklearn
import tensorflow as tf
import wandb
import h5py

print("Python:", sys.version.split()[0])
print(
    "Deps OK | numpy:", numpy.__version__,
    "| scipy:", scipy.__version__,
    "| pandas:", pandas.__version__,
    "| sklearn:", sklearn.__version__,
    "| tensorflow:", tf.__version__,
    "| wandb:", wandb.__version__,
    "| h5py:", h5py.__version__,
)
# GPU may be absent at build time; only check import of CUDA plugin path
print("TF built with CUDA:", tf.test.is_built_with_cuda())
PY

%labels
    Author NiekBrouwer
    Version 1.1.0
    Description CCSynergy/DrugZip + tensorflow[and-cuda]; code bind-mounted at runtime

%help
    Build from the repo root (needs environment.yml on the build path):

        cd /path/to/drugzip
        apptainer build containers/ccsynergy.sif containers/ccsynergy.def

    Install on cluster as $PROJECTDIR/containers/ccsynergy.sif

    GPU run:

        apptainer exec --nv --bind $PROJECTDIR:$PROJECTDIR \
            $PROJECTDIR/containers/ccsynergy.sif \
            python -c "import tensorflow as tf; print(tf.config.list_physical_devices('GPU'))"
